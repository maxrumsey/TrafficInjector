<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(HOMEPATH)\Documents\vatSys Files\Profiles\Australia\Plugins\Traffic Injector\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <VatSysDir>$(MSBuildProgramFiles32)\vatSys</VatSysDir>
	<PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
    <PackageReference Include="System.Composition" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(VatSysDir)\bin\vatSys.exe">
		<Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
